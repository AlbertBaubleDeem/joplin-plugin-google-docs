{
	"manifest_version": 1,
	"id": "io.github.albertbaubledeem.joplin.google-docs",
	"app_min_version": "2.6",
	"version": "1.0.3",
	"name": "Google Docs Sync",
	"description": "Sync Joplin notes with Google Docs",
	"author": "AlbertBaubleDeem",
	"homepage_url": "https://github.com/AlbertBaubleDeem/joplin-plugin-google-docs",
	"repository_url": "https://github.com/AlbertBaubleDeem/joplin-plugin-google-docs",
	"keywords": ["google-docs", "sync"],
	"categories": ["integrations"],
	"screenshots": [
		{
			"src": "screenshots/screenshot_doc.png",
			"label": "Google Doc synced from a Joplin note"
		},
		{
			"src": "screenshots/screenshot_wizard.png",
			"label": "Setup wizard guiding through Google Cloud configuration"
		}
	],
	"icons": {
		"16": "images/icon16.png",
		"32": "images/icon32.png",
		"48": "images/icon48.png",
		"128": "images/icon128.png"
	},
	"platforms": ["desktop"]
}
